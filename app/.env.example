# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Google Calendar (Sprint 5) ────────────────────────────────
GOOGLE_CLIENT_ID=             # OAuth Client ID de Google Cloud (scope Calendar unicamente)
GOOGLE_CLIENT_SECRET=         # OAuth Client Secret
GOOGLE_REDIRECT_URI=          # Debe coincidir exacto con lo registrado en Google Cloud, ej: http://localhost:3000/api/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=  # 32 bytes en hex (64 caracteres). Generar con:
                               # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
